# Port the HTTP server listens on
PORT=4000

# Shared-secret signature the simulated printer worker sends on webhook calls.
# In production this would be a vendor-issued HMAC secret validated per-request.
WEBHOOK_SECRET=dev-webhook-secret

# Where the worker posts its webhook callback. Defaults to the local server.
WEBHOOK_URL=http://localhost:4000/api/webhooks/badge-printer

# SQLite database file path (see README for why SQLite is used for this MVP
# instead of the originally-recommended PostgreSQL).
DB_PATH=./data/solstice.db
